---
import type { CollectionEntry } from 'astro:content';
interface Props { guide: CollectionEntry<'guides'> }
const { guide } = Astro.props;
---
<li>
  <a class="row" href={`/ja/guides/${guide.id}/`}>
    <img src={`/images/guides/${guide.id}.webp`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
    <div>
      <h3>{guide.data.h1}</h3>
      <p>{guide.data.description}</p>
    </div>
  </a>
</li>
