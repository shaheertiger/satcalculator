                <td class="px-4 py-3 font-bold">730</td>
              </tr>
              <tr class="bg-slate-50 border-b border-slate-100">
                <td class="px-4 py-3 font-semibold">37</td>
                <td class="px-4 py-3">7</td>
                <td class="px-4 py-3 font-bold">700</td>
              </tr>
              <tr class="bg-white border-b border-slate-100">
                <td class="px-4 py-3 font-semibold">34</td>
                <td class="px-4 py-3">10</td>
                <td class="px-4 py-3 font-bold">650</td>
              </tr>
              <tr class="bg-slate-50 border-b border-slate-100">
                <td class="px-4 py-3 font-semibold">30</td>
                <td class="px-4 py-3">14</td>
                <td class="px-4 py-3 font-bold">580</td>
              </tr>
              <tr class="bg-white border-b border-slate-100">
                <td class="px-4 py-3 font-semibold">25</td>
                <td class="px-4 py-3">19</td>
                <td class="px-4 py-3 font-bold">500</td>
              </tr>
              <tr class="bg-slate-50">
                <td class="px-4 py-3 font-semibold rounded-bl-lg">20</td>
                <td class="px-4 py-3">24</td>
                <td class="px-4 py-3 font-bold rounded-br-lg">430</td>
              </tr>
            </tbody>
          </table>
        </div>

        <p class="text-xs text-slate-400">
          Estimates derived from official College Board Bluebook practice test scoring tables. Actual curves vary by test form.
        </p>

        <p>
          And here is the estimated curve for the <strong>easier Module 2 path</strong>:
        </p>

        <div class="overflow-x-auto !my-6">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="bg-slate-800 text-white">
                <th class="px-4 py-3 text-left rounded-tl-lg">Raw Score (out of 44)</th>
                <th class="px-4 py-3 text-left">Questions Missed</th>
                <th class="px-4 py-3 text-left rounded-tr-lg">Estimated Scaled Score</th>
              </tr>
            </thead>
            <tbody>
              <tr class="bg-white border-b border-slate-100">
                <td class="px-4 py-3 font-semibold">44</td>
                <td class="px-4 py-3">0</td>
                <td class="px-4 py-3 font-bold text-amber-700">~650</td>
              </tr>
              <tr class="bg-slate-50 border-b border-slate-100">
                <td class="px-4 py-3 font-semibold">42</td>
                <td class="px-4 py-3">2</td>
